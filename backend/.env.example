# # Wine Friend backend (API)

# PORT=4000

# # Admin login used by the dashboard. Use a long, unique password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# # Random string of 32+ characters used to sign login sessions. Generate with:
# #   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# # MongoDB connection string (MongoDB Atlas -> Connect -> Drivers). Products, posts, enquiries
# # and uploaded images are all stored here. Never commit the real value.
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
# # Database name inside the cluster (defaults to "winefriend").
# # MONGODB_DB=winefriend

# # Public website address + shared secret: after every save the backend asks the website
# # to refresh its cached pages. REVALIDATE_SECRET must equal the website's value.
# WEBSITE_URL=http://localhost:3000
# REVALIDATE_SECRET=





