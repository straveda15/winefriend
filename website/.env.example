# Public website (website/)

# Where the backend API runs. It must be reachable from the website server.
BACKEND_URL=http://localhost:4000

# Shared secret that lets the backend refresh the website's cache after a save.
# Use the same value in the backend's REVALIDATE_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=

# Optional: link to the dedicated Nashik wine tours website (shown on the Wine Tours page).
# NEXT_PUBLIC_TOUR_SITE_URL=https://example.com
